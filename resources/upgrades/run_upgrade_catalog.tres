[gd_resource type="Resource" script_class="ActionDashUpgradeCatalog" load_steps=18 format=3]

[ext_resource type="Script" path="res://scripts/upgrade_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://scripts/run_upgrade.gd" id="2_upgrade"]

[sub_resource type="Resource" id="CardKinetic"]
script = ExtResource("2_upgrade")
id = &"card_kinetic_force"
title = "Fuerza cinética"
description = "+0.35 de daño melee base"
category = "Card"
stat_id = &"melee_damage"
operation = "Add"
value = 0.35

[sub_resource type="Resource" id="CardEnergy"]
script = ExtResource("2_upgrade")
id = &"card_energy_core"
title = "Núcleo de energía"
description = "+1.0 de daño de esfera"
category = "Card"
stat_id = &"ranged_damage"
operation = "Add"
value = 1.0

[sub_resource type="Resource" id="CardCharge"]
