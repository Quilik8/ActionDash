[resource]
script = ExtResource("1_catalog")
cards = Array[ExtResource("2_upgrade")]([SubResource("CardKinetic"), SubResource("CardEnergy"), SubResource("CardCharge"), SubResource("CardRadius"), SubResource("CardOrbSpeed"), SubResource("CardVelocity"), SubResource("CardDrive")])
movement_tree = Array[ExtResource("2_upgrade")]([SubResource("MoveSpeed"), SubResource("MoveAccel"), SubResource("MoveJump")])
melee_tree = Array[ExtResource("2_upgrade")]([SubResource("MeleeDamage"), SubResource("MeleeRadius"), SubResource("MeleeMax")])
ranged_tree = Array[ExtResource("2_upgrade")]([SubResource("RangedDamage"), SubResource("RangedCooldown"), SubResource("RangedSize")])
